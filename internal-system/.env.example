# Example environment variables for local development only.
# Copy to a local .env file; never commit real values.
# Use the public/publishable client key in the browser only when RLS is configured.
# Keep service-role keys and database passwords server-side in secret storage.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only examples (do not expose to browser build)
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
